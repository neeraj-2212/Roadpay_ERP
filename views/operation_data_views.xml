<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Transaction List View #T10788-->
    <record id="roadpay_operation_data_list" model="ir.ui.view">
        <field name="name">roadpay.operation.data.list</field>
        <field name="model">roadpay.operation.data</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="ID"/>
                <field name="state" widget="badge" optional="show"/>
                <field name="plaza_id"/>
                <field name="manager_id"/>
                <field name="operator_id" domain="[('plaza_id','=',plaza_id),('gate_no','=',gate_no)]"/>
                <field name="gate_no"/>
                <field name="vehicle_no"/>
                <field name="vehicle_type"/>
                <field name="toll_amount"/>
                <field name="timestamp"/>
                <field name="status" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Transaction Form View #T10788-->
    <record id="roadpay_operation_data_form" model="ir.ui.view">
        <field name="name">roadpay.operation.data.form</field>
        <field name="model">roadpay.operation.data</field>
        <field name="arch" type="xml">
            <form string="Transaction">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="new,pending,paid,cancel"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="plaza_id"/>
                            <field name="manager_id"/>
                            <field name="operator_id" domain="[('id','=',uid)]"/>
                            <field name="gate_no" readonly="1"/>
                        </group>
                        <group>
                            <field name="vehicle_no"/>
                            <field name="vehicle_type"/>
                            <field name="toll_amount" readonly="1"/>
                            <field name="timestamp"/>
                            <field name="status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Transaction Action #T10788-->
    <record id="action_roadpay_operation" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">roadpay.operation.data</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
