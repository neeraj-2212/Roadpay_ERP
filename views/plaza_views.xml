<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plaza List View #T10787 -->
    <record id="roadpay_plaza_list" model="ir.ui.view">
        <field name="name">roadpay.plaza.list</field>
        <field name="model">roadpay.plaza</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="manager_id"/>
                <field name="total_gates"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Plaza Form View #T10787 -->
    <record id="roadpay_plaza_form" model="ir.ui.view">
        <field name="name">roadpay.plaza.form</field>
        <field name="model">roadpay.plaza</field>
        <field name="arch" type="xml">
            <form string="Plaza">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="manager_id"/>
                        <field name="total_gates"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Rates">
                            <field name="rate_ids">
                                <list editable="bottom">
                                    <field name="vehicle_type"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Plaza Action #T10787 -->
    <record id="action_roadpay_plaza" model="ir.actions.act_window">
        <field name="name">Plazas</field>
        <field name="res_model">roadpay.plaza</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
